# packwiz binary - re-download per scripts/setup-tools.ps1, don't commit 12MB
.tools/

# Materialised server mods - generated by drop.ps1, never source of truth
serverpack/mods/
serverpack/packwiz.json

# Tooling jars - fetched by setup-tools.ps1. packwiz-installer.jar in particular
# is written by the bootstrap at runtime as it self-updates, so tracking it means
# a spurious diff on every single drop.
packwiz-installer-bootstrap.jar
packwiz-installer.jar

# Exported packs
*.zip
*.mrpack

# Secrets: Pterodactyl API key, SFTP creds
drop.config.ps1

# Prism instance build output
prism-instance/.minecraft/packwiz-installer-bootstrap.jar
prism-instance/.minecraft/packwiz.json
prism-instance/.minecraft/mods/
